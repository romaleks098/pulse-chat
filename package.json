{
  "name": "pulse-chat",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "start": "cd server && node dist/index.js",
    "desktop": "cd desktop && npm start",
    "cap:sync": "cd client && npm run cap:sync",
    "cap:android": "cd client && npm run cap:android",
    "check:secrets": "node scripts/check_secrets.js",
    "test:stages": "node scripts/test_stages_3_4.js && node scripts/test_db_heal_saved.js && node scripts/test_stages_5_6_7.js && node scripts/test_hotfix_blackscreen.js",
    "test": "npm run test:stages"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
